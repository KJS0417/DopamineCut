<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/auth_nav_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/auth_unavailable_group"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/ui_space_large"
        android:visibility="gone">

        <TextView
            style="@style/TextAppearance.DopamineCut.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/firebase_unavailable_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_space_small"
            android:gravity="center"
            android:text="@string/firebase_unavailable_message" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_retry_firebase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_space_large"
            android:text="@string/retry" />
    </LinearLayout>
</FrameLayout>
