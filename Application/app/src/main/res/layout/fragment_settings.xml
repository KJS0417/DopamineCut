<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/ui_background" android:padding="16dp">
    <LinearLayout android:id="@+id/settings_overview" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/tab_title" style="@style/Widget.DopamineCut.TabTitle" android:text="@string/settings_title" />
        <TextView style="@style/Widget.DopamineCut.SettingsCompactTitle" android:text="@string/notification_habit_heading" android:textSize="14sp" android:layout_marginTop="8dp" />
        <TextView style="@style/Widget.DopamineCut.SettingsCompactBody" android:text="@string/notification_habit_frequency" android:textSize="12sp" />
        <LinearLayout style="@style/Widget.DopamineCut.SettingsCompactCard" android:orientation="horizontal" android:padding="4dp">
            <CheckBox android:id="@+id/cb_notification_morning" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:text="오전\n08:00" android:textSize="12sp" android:enabled="false" />
<CheckBox android:id="@+id/cb_notification_lunch" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:text="점심\n12:00" android:textSize="12sp" android:enabled="false" />
<CheckBox android:id="@+id/cb_notification_evening" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:text="늦은 저녁\n21:00" android:textSize="12sp" android:enabled="false" />
        </LinearLayout>
        <LinearLayout style="@style/Widget.DopamineCut.SettingsCompactCard" android:background="@drawable/ui_preview_background" android:padding="10dp">
            <TextView style="@style/Widget.DopamineCut.SettingsCompactBody" android:text="@string/notification_example_label" android:textSize="11sp" />
            <TextView style="@style/Widget.DopamineCut.SettingsCompactBody" android:text="@string/notification_example_message" android:textSize="12sp" android:textColor="@color/ui_text_primary" />
        </LinearLayout>
        <GridLayout android:id="@+id/settings_tab_grid" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2" android:rowCount="3" android:layout_marginTop="8dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/tab_notifications" style="@style/Widget.DopamineCut.SettingsTab" android:text="@string/notification_settings_title" />
<com.google.android.material.button.MaterialButton android:id="@+id/tab_account" style="@style/Widget.DopamineCut.SettingsTab" android:text="@string/account" />
<com.google.android.material.button.MaterialButton android:id="@+id/tab_measurement" style="@style/Widget.DopamineCut.SettingsTab" android:text="@string/measurement_status" />
<com.google.android.material.button.MaterialButton android:id="@+id/tab_analysis" style="@style/Widget.DopamineCut.SettingsTab" android:text="@string/analysis_scope" />
<com.google.android.material.button.MaterialButton android:id="@+id/tab_data" style="@style/Widget.DopamineCut.SettingsTab" android:text="데이터 및 연결정보" />
<com.google.android.material.button.MaterialButton android:id="@+id/tab_app_info" style="@style/Widget.DopamineCut.SettingsTab" android:text="@string/app_information" />
        </GridLayout>
    </LinearLayout>
    <TextView android:id="@+id/tv_settings_section_title" style="@style/Widget.DopamineCut.SettingsCompactTitle" android:text="@string/notification_settings_title" android:layout_marginTop="10dp" android:layout_marginBottom="4dp" android:accessibilityLiveRegion="polite" />
    <ScrollView android:id="@+id/settings_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="12dp">
            <ProgressBar android:id="@+id/progress_loading" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center_horizontal" android:visibility="gone" />
            <LinearLayout android:id="@+id/panel_notifications" style="@style/Widget.DopamineCut.SettingsCompactCard">
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switch_goal_notifications" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/notification_goal_progress" android:textSize="13sp" android:enabled="false" />
                <TextView style="@style/Widget.DopamineCut.SettingsCompactBody" android:text="@string/notification_goal_progress_description" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switch_measurement_notifications" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/notification_measurement_interruption" android:textSize="13sp" android:enabled="false" />
                <TextView style="@style/Widget.DopamineCut.SettingsCompactBody" android:text="@string/notification_measurement_interruption_description" />
                <TextView style="@style/Widget.DopamineCut.SettingsCompactBody" android:text="@string/notification_independent_notice" />
                <TextView style="@style/Widget.DopamineCut.SettingsCompactBody" android:text="@string/notification_integration_notice" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_notification_permission" style="@style/Widget.DopamineCut.SettingsCompactButton" android:layout_marginTop="8dp" android:text="Android 알림 허용 설정" />
            </LinearLayout>
            <LinearLayout android:id="@+id/panel_account" style="@style/Widget.DopamineCut.SettingsCompactCard" android:visibility="gone">
                <TextView android:id="@+id/tv_nickname" style="@style/Widget.DopamineCut.SettingsCompactTitle" />
                <TextView android:id="@+id/tv_email" style="@style/Widget.DopamineCut.SettingsCompactBody" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_change_intervention" style="@style/Widget.DopamineCut.SettingsCompactButton" android:text="@string/change_intervention" android:layout_marginTop="8dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_logout" style="@style/Widget.DopamineCut.SettingsCompactButton" android:text="@string/logout" android:textColor="@color/ui_error" app:strokeColor="@color/ui_error" android:layout_marginTop="8dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/panel_measurement" style="@style/Widget.DopamineCut.SettingsCompactCard" android:visibility="gone">
                <TextView style="@style/Widget.DopamineCut.SettingsCompactTitle" android:text="@string/accessibility_service" />
                <TextView android:id="@+id/tv_accessibility_status" style="@style/Widget.DopamineCut.SettingsCompactBody" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_accessibility_settings" style="@style/Widget.DopamineCut.SettingsCompactButton" android:text="@string/open_accessibility_settings" />
                <TextView style="@style/Widget.DopamineCut.SettingsCompactTitle" android:text="@string/usage_access" android:layout_marginTop="12dp" />
                <TextView android:id="@+id/tv_usage_status" style="@style/Widget.DopamineCut.SettingsCompactBody" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_usage_settings" style="@style/Widget.DopamineCut.SettingsCompactButton" android:text="@string/open_usage_settings" />
            </LinearLayout>
            <LinearLayout android:id="@+id/panel_analysis" style="@style/Widget.DopamineCut.SettingsCompactCard" android:visibility="gone">
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switch_measurement" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:checked="true" android:enabled="false" android:text="@string/basic_usage_analysis" android:textSize="13sp" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switch_content_analysis" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:enabled="false" android:text="@string/content_analysis" android:textSize="13sp" />
                <TextView style="@style/Widget.DopamineCut.SettingsCompactBody" android:text="@string/privacy_capture_notice" />
                <TextView style="@style/Widget.DopamineCut.SettingsCompactBody" android:text="@string/settings_not_connected" android:textColor="@color/ui_warning" />
            </LinearLayout>
            <LinearLayout android:id="@+id/panel_data" style="@style/Widget.DopamineCut.SettingsCompactCard" android:visibility="gone">
                <TextView style="@style/Widget.DopamineCut.SettingsCompactTitle" android:text="데이터 보관·연결" />
                <TextView style="@style/Widget.DopamineCut.SettingsCompactBody" android:text="기기에 먼저 저장한 뒤 서버에 동기화해요. 연결이 끊기면 미전송 기록을 보관하고 다시 시도해요." />
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_delete_today" style="@style/Widget.DopamineCut.SettingsCompactButton" android:enabled="false" android:text="오늘 기록 삭제" android:layout_marginTop="8dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_delete_all" style="@style/Widget.DopamineCut.SettingsCompactButton" android:enabled="false" android:text="전체 사용 기록 삭제" android:textColor="@color/ui_error" app:strokeColor="@color/ui_error" android:layout_marginTop="8dp" />
            </LinearLayout>
            <LinearLayout android:id="@+id/panel_app_info" style="@style/Widget.DopamineCut.SettingsCompactCard" android:visibility="gone">
                <TextView style="@style/Widget.DopamineCut.SettingsCompactTitle" android:text="@string/app_name" />
                <TextView style="@style/Widget.DopamineCut.SettingsCompactBody" android:text="@string/app_version_value" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
