<resources>
    <style name="Widget.DopamineCut.SettingsCompactBody" parent="Widget.DopamineCut.BodySpacing">
        <item name="android:textSize">13sp</item><item name="android:layout_marginTop">4dp</item><item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="Widget.DopamineCut.SettingsCompactTitle" parent="TextAppearance.DopamineCut.Title">
        <item name="android:textSize">16sp</item><item name="android:textStyle">normal</item><item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Widget.DopamineCut.SettingsCompactCard" parent="Widget.DopamineCut.PrototypeCard">
        <item name="android:padding">12dp</item><item name="android:layout_marginTop">8dp</item>
    </style>
    <style name="Widget.DopamineCut.SettingsCompactButton" parent="Widget.DopamineCut.PrototypeOutline">
        <item name="android:textSize">13sp</item><item name="android:paddingLeft">8dp</item><item name="android:paddingRight">8dp</item>
        <item name="android:insetTop">0dp</item><item name="android:insetBottom">0dp</item>
    </style>
    <style name="Widget.DopamineCut.SettingsTab" parent="Widget.DopamineCut.SettingsCompactButton">
        <item name="android:layout_width">0dp</item><item name="android:layout_columnWeight">1</item><item name="android:layout_gravity">fill</item>
        <item name="android:layout_margin">3dp</item><item name="android:minWidth">0dp</item><item name="android:textSize">12sp</item>
        <item name="android:paddingLeft">4dp</item><item name="android:paddingRight">4dp</item>
        <item name="android:singleLine">false</item><item name="android:maxLines">2</item>
        <item name="backgroundTint">@color/settings_tab_background</item>
    </style>
</resources>
