<resources>
    <style name="Widget.DopamineCut.PrototypeCard" parent="">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item><item name="android:background">@drawable/ui_card_background</item>
        <item name="android:orientation">vertical</item><item name="android:padding">16dp</item>
    </style>
    <style name="Widget.DopamineCut.PrototypePill" parent="">
        <item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/ui_pill_background</item><item name="android:textColor">@color/ui_primary</item>
        <item name="android:textSize">12sp</item><item name="android:layout_marginBottom">12dp</item>
    </style>
    <style name="Widget.DopamineCut.PrototypePrimary" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item><item name="android:layout_marginTop">16dp</item><item name="cornerRadius">12dp</item>
        <item name="android:insetTop">0dp</item><item name="android:insetBottom">0dp</item>
    </style>
    <style name="Widget.DopamineCut.PrototypeOutline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item><item name="cornerRadius">12dp</item><item name="strokeColor">@color/ui_outline</item>
    </style>
    <style name="Widget.DopamineCut.PrototypeInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item><item name="boxBackgroundColor">@color/ui_surface</item>
        <item name="boxCornerRadiusTopStart">12dp</item><item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item><item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>
</resources>
