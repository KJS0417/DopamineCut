<resources>
    <style name="Widget.DopamineCut.StatsCard" parent="Widget.DopamineCut.PrototypeCard">
        <item name="android:padding">10dp</item><item name="android:layout_marginTop">8dp</item>
    </style>
    <style name="Widget.DopamineCut.StatsBody" parent="Widget.DopamineCut.BodySpacing">
        <item name="android:textSize">12sp</item><item name="android:layout_marginTop">4dp</item><item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="Widget.DopamineCut.StatsTitle" parent="TextAppearance.DopamineCut.Title">
        <item name="android:textSize">14sp</item><item name="android:layout_marginTop">12dp</item>
    </style>
    <style name="Widget.DopamineCut.StatsFilter" parent="Widget.DopamineCut.PrototypeOutline">
        <item name="android:layout_width">0dp</item><item name="android:layout_weight">1</item>
        <item name="android:minWidth">0dp</item><item name="android:textSize">12sp</item>
        <item name="android:paddingLeft">3dp</item><item name="android:paddingRight">3dp</item>
        <item name="android:insetTop">0dp</item><item name="android:insetBottom">0dp</item>
        <item name="android:maxLines">2</item>
    </style>
</resources>
